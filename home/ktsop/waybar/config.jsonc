{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "temperature", "pulseaudio", "network", "battery", "tray"],
  "hyprland/workspaces": { "format": "{icon}", "on-scroll": "hyprctl dispatch workspace {direction}" },
  "clock": { "format": "{:%a %d %b  %H:%M}", "tooltip-format": "{:%Y-%m-%d}" },
  "cpu": { "format": " {usage}%" },
  "memory": { "format": " {used:0.1f}G" },
  "temperature": { "critical-threshold": 80, "format": " {temperatureC}°C" },
  "pulseaudio": { "format": "{icon} {volume}%", "format-muted": "", "scroll-step": 2 },
  "network": { "format-wifi": " {essid} {signalStrength}%", "format-ethernet": " {ipaddr}", "format-disconnected": "" },
  "battery": { "format": "{capacity}% {icon}", "format-charging": " {capacity}%" },
  "tray": { "icon-size": 16, "spacing": 8 }
}
